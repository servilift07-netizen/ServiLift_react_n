# Copie este archivo como .env y ajuste sus valores. El .env no se sube a git.

# ── Base de datos: MariaDB en Docker (docker compose up -d, puerto 3307) ──
DB_USER=servilift
DB_PASSWORD=servilift
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=servilift_db
# Con el MySQL de XAMPP en lugar de Docker use: DB_USER=root, DB_PASSWORD= (vacío) y DB_PORT=3306

# ── Zona horaria de las fechas (Colombia, sin horario de verano) ──
ZONA_HORARIA=-05:00

# ── JWT: opcional. Si no se define se usa la clave de demostración del proyecto ──
# SECRET_KEY=

# ── Archivos (fotos, firmas, PDF) ──
STORAGE_DIR=storage
MAX_FOTO_MB=15
# Vigencia (minutos) de los enlaces firmados de fotos y firmas
ARCHIVOS_URL_MINUTOS=720

# ── URL que va en el QR del certificado ──
URL_VERIFICACION=http://localhost:8000/verificar

# ── Orígenes web permitidos en producción (separados por coma). En desarrollo localhost ya está permitido ──
CORS_ORIGINS=
